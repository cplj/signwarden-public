{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SignWarden suite",
  "description": "Structural contract; duplicate IDs, reference resolution, fault semantics and adapter-specific fixtures need runtime validation.",
  "type": "object",
  "required": [
    "fixtures",
    "cases"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "suite": {
      "type": "string"
    },
    "fixtures": {
      "type": "object"
    },
    "expectation_strategy": {},
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": [
        "id",
        "title",
        "steps"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "fixtures": {
          "type": "object"
        },
        "faults": {
          "type": "object"
        },
        "expect_total_effects": {
          "type": "integer",
          "minimum": 0
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "enum": [
                  "advance_clock",
                  "set_policy",
                  "delegate",
                  "revoke",
                  "approve",
                  "call",
                  "resume"
                ]
              },
              "expect": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "enum": [
                        "executed",
                        "denied",
                        "pending_approval",
                        "error",
                        "unknown"
                      ]
                    }
                  },
                  "effects": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
