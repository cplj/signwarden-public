{
 "suite": "sample",
 "schema": "signwarden.cases.v0",
 "version": "0.2.0",
 "note": "A 12-case sample. The full coverage suite is not part of this repository.",
 "expectation_strategy": {
  "approval": "single-use; bound to approver, tool, tenant, exact args and policy version",
  "retry": "after unknown, retry allowed only with the same idempotency key; tool dedups by key",
  "denial_status": "approval mismatches may answer denied or pending_approval; neither may cause a side effect",
  "identity": "agent calls must name on_behalf_of; a delegation is bound to one agent",
  "args_match": "exact, case-sensitive",
  "pause": "a call needing approval returns pending_approval with a pending_id; resume re-checks identity, delegation, tenant and approver against the state at resume time; a policy change while paused requires a new approval; each pending call can be resumed once",
  "edited_args": "the principal may edit arguments when approving; the edited arguments are what is authorized and executed"
 },
